          "log": true
        },
        "weight_decay": {
          "type": "float",
          "low": 1e-06,
          "high": 0.001,
          "log": true
        },
        "momentum": {
          "type": "float",
          "low": 0.8,
          "high": 0.95,
          "condition": {
            "parameter": "optimizer",
