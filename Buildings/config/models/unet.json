{
  "model_type": "unet",
  "task_type": "semantic_segmentation",
  "description": "Vanilla U-Net model for semantic building extraction",

  "num_classes": 1,
  "input_channels": 3,

  "default_backbone": "vanilla_unet",
  "backbone": "vanilla_unet",

  "pretrained": false,
  "aux_loss": false,

  "supported_backbones": {
    "vanilla_unet": {
      "name": "vanilla_unet",
      "display_name": "Vanilla U-Net",
      "automatic_batch_size": 8,
      "pretrained": false,
      "description": "Classic U-Net encoder-decoder without an external pretrained backbone"
    },
    "standard": {
      "name": "vanilla_unet",
      "display_name": "Vanilla U-Net",
      "automatic_batch_size": 8,
      "pretrained": false,
      "description": "Alias for vanilla_unet, kept for compatibility"
    }
  },

  "backbones": {
    "vanilla_unet": {
      "name": "vanilla_unet",
      "display_name": "Vanilla U-Net",
      "automatic_batch_size": 8,
      "pretrained": false,
      "description": "Classic U-Net encoder-decoder without an external pretrained backbone"
    },
    "standard": {
      "name": "vanilla_unet",
      "display_name": "Vanilla U-Net",
      "automatic_batch_size": 8,
      "pretrained": false,
      "description": "Alias for vanilla_unet, kept for compatibility"
    }
  },

  "architecture": {
    "encoder_channels": [64, 128, 256, 512],
    "decoder_channels": [512, 256, 128, 64],
    "bottleneck_channels": 1024,
    "use_batch_norm": true,
    "dropout": 0.0
  },

  "loss": {
    "type": "bce_dice",
    "bce_weight": 0.5,
    "dice_weight": 0.5,
    "aux_weight": 0.0
  },

  "normalization": {
    "enabled": false,
    "method": "none",
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },

  "output": {
    "activation": "sigmoid",
    "threshold": 0.5
  }
}