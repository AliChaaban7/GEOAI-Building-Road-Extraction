{
  "model_type": "deeplabv3",
  "task_type": "semantic_segmentation",
  "description": "Standard DeepLabV3 model for semantic building extraction",

  "num_classes": 1,
  "input_channels": 3,
  "default_backbone": "resnet50",
  "backbone": "resnet50",

  "pretrained": false,
  "aux_loss": false,

  "supported_backbones": {
    "resnet50": {
      "name": "resnet50",
      "automatic_batch_size": 8,
      "pretrained": false
    },
    "resnet101": {
      "name": "resnet101",
      "automatic_batch_size": 4,
      "pretrained": false
    },
    "mobilenet_v3_large": {
      "name": "mobilenet_v3_large",
      "automatic_batch_size": 8,
      "pretrained": false
    }
  },

  "backbones": {
    "resnet50": {
      "name": "resnet50",
      "automatic_batch_size": 8,
      "pretrained": false
    },
    "resnet101": {
      "name": "resnet101",
      "automatic_batch_size": 4,
      "pretrained": false
    },
    "mobilenet_v3_large": {
      "name": "mobilenet_v3_large",
      "automatic_batch_size": 8,
      "pretrained": false
    }
  },

  "loss": {
    "type": "bce_dice",
    "bce_weight": 0.5,
    "dice_weight": 0.5,
    "aux_weight": 0.0
  },

  "normalization": {
    "enabled": false,
    "method": "none",
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },

  "output": {
    "activation": "sigmoid",
    "threshold": 0.5
  }
}